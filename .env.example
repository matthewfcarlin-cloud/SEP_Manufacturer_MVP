ANTHROPIC_API_KEY=
# Optional overrides for the analysis call (defaults shown)
# IDLEFIT_MODEL=claude-opus-5
# IDLEFIT_EFFORT=high

# Required. Encrypts creators' own AI keys at rest (AES-256-GCM).
# Must be 32 random bytes, base64-encoded. Generate one with:
#   openssl rand -base64 32
# The server refuses to start without it. Keep it secret and stable:
# changing it makes every saved key unreadable (creators re-add them).
KEY_ENCRYPTION_SECRET=

# Optional. Etsy store drafts (Sell screen). From an app registered at
# https://www.etsy.com/developers/your-apps. Register the callback URL
# https://<your site>/api/stores/etsy/callback on the app. Without these the
# Sell screen shows Etsy as "Needs setup".
# ETSY_API_KEYSTRING=
# ETSY_SHARED_SECRET=
# Only if the callback URL can't be derived from the request (e.g. behind an unusual proxy):
# ETSY_REDIRECT_URI=
