{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "npm run demo:seed && npm start",
    "healthcheckPath": "/shops",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
